#!/usr/bin/env bash
# Resolve ~/.config/theme/manifest.toml and write generated tool configs.
set -euo pipefail

THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
GENERATED_DIR="$THEME_DIR/generated"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
MANIFEST="$THEME_DIR/manifest.toml"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

quiet=false
if [[ "${1:-}" == "--quiet" ]]; then
  quiet=true
fi

if [[ ! -f "$MANIFEST" ]]; then
  echo "theme-sync: missing manifest at $MANIFEST" >&2
  exit 1
fi

mkdir -p "$GENERATED_DIR"

# State lives under ~/.local/state (never stowed); recover from broken symlinks.
if [[ -L "$STATE_DIR" && ! -e "$STATE_DIR" ]]; then
  rm "$STATE_DIR"
fi
mkdir -p "$STATE_DIR"

export THEME_DIR GENERATED_DIR STATE_DIR MANIFEST CONFIG_HOME

sync_exit=0
python3 <<'PY' || sync_exit=$?
import hashlib
import json
import os
import subprocess
import sys
import tomllib
from pathlib import Path

theme_dir = Path(os.environ["THEME_DIR"])
generated = Path(os.environ["GENERATED_DIR"])
state_dir = Path(os.environ["STATE_DIR"])
manifest_path = Path(os.environ["MANIFEST"])
config_home = Path(os.environ["CONFIG_HOME"])

manifest = tomllib.loads(manifest_path.read_text())
family = manifest["family"]
mode = manifest.get("mode", "system")

if family not in manifest["families"]:
    sys.exit(f"theme-sync: unknown family '{family}' in manifest.toml")

family_cfg = manifest["families"][family]
tmux_style = family_cfg.get("tmux_style", "catppuccin")
p10k_style = family_cfg.get("p10k_style", "catppuccin")


def detect_appearance() -> str:
    if mode != "system":
        return mode
    if sys.platform == "darwin":
        result = subprocess.run(
            ["defaults", "read", "-g", "AppleInterfaceStyle"],
            capture_output=True,
            text=True,
        )
        return "dark" if "Dark" in (result.stdout or "") else "light"
    return "dark"


def variant(tool: str, appearance: str) -> str:
    value = family_cfg[tool]
    if isinstance(value, dict):
        return value[appearance]
    return str(value)


appearance = detect_appearance()
manifest_hash = hashlib.sha256(manifest_path.read_bytes()).hexdigest()

tools = {
    key: {
        "dark": variant(key, "dark"),
        "light": variant(key, "light"),
        "current": variant(key, appearance),
    }
    for key in family_cfg
    if isinstance(family_cfg[key], dict) and "dark" in family_cfg[key]
}

state = {
    "family": family,
    "mode": mode,
    "appearance": appearance,
    "manifest_hash": manifest_hash,
    "tmux_style": tmux_style,
    "p10k_style": p10k_style,
    "tools": {key: values["current"] for key, values in tools.items()},
}

state_file = state_dir / "current.json"
previous = None
if state_file.exists():
    try:
        previous = json.loads(state_file.read_text())
    except json.JSONDecodeError:
        previous = None

unchanged = (
    previous is not None
    and previous.get("appearance") == appearance
    and previous.get("family") == family
    and previous.get("manifest_hash") == manifest_hash
)

if unchanged:
    sys.exit(0)

state_file.write_text(json.dumps(state, indent=2) + "\n")

env_lines = [
    f'export THEME_FAMILY="{family}"',
    f'export THEME_APPEARANCE="{appearance}"',
    f'export THEME_VARIANT="{tools.get("p10k", {}).get("current", appearance)}"',
    f'export THEME_TMUX_STYLE="{tmux_style}"',
    f'export THEME_P10K_STYLE="{p10k_style}"',
    f'export BAT_THEME="{state["tools"]["bat"]}"',
]

if p10k_style == "catppuccin":
    env_lines.append(f'export P10K_CATPPUCCIN_FLAVOUR="{state["tools"]["p10k"]}"')
else:
    env_lines.append('export P10K_CATPPUCCIN_FLAVOUR=""')

for key, value in state["tools"].items():
    env_lines.append(f'export THEME_{key.upper()}="{value}"')

lazygit_gui = generated / "lazygit-gui.yml"
lazygit_base = config_home / "lazygit" / "config.yml"
env_lines.append(
    f'export LG_CONFIG_FILE="{lazygit_base},{lazygit_gui}"'
)

(state_dir / "current.env").write_text("\n".join(env_lines) + "\n")

(generated / "ghostty.ghostty").write_text(
    "\n".join(
        [
            "# Generated by theme-sync — do not edit",
            f"theme = dark:{tools['ghostty']['dark']},light:{tools['ghostty']['light']}",
            "window-theme = system",
            "",
        ]
    )
)

tmux_template = """# Generated by theme-sync — do not edit
set -g @catppuccin_flavor '{flavor}'
set -g @catppuccin_reset true
source-file ~/.config/tmux/catppuccin-clear-modules.conf
run-shell 'if [ -r "${{HOME}}/.tmux/plugins/tmux/catppuccin.tmux" ]; then "${{HOME}}/.tmux/plugins/tmux/catppuccin.tmux"; fi'
source-file ~/.config/tmux/catppuccin-overrides.conf
run-shell 'if [ -r "${{HOME}}/.tmux/plugins/tmux/catppuccin.tmux" ]; then "${{HOME}}/.tmux/plugins/tmux/catppuccin.tmux"; fi'
source-file ~/.config/tmux/post-theme.conf
"""

for mode_name in ("dark", "light"):
    generated_tmux = generated / f"tmux-{mode_name}.conf"
    if tmux_style == "catppuccin":
        generated_tmux.write_text(
            tmux_template.format(flavor=tools["tmux"][mode_name])
        )
        continue

    source_tmux = theme_dir / "families" / family / f"tmux-{mode_name}.conf"
    if not source_tmux.exists():
        sys.exit(f"theme-sync: missing tmux theme at {source_tmux}")
    generated_tmux.write_text(
        "# Generated by theme-sync — do not edit\n" + source_tmux.read_text()
    )

delta_theme = state["tools"]["delta"]
delta_lines = [
    "# Generated by theme-sync — do not edit",
    "[delta]",
    f"\tsyntax-theme = {delta_theme}",
]
if appearance == "dark":
    delta_lines.append("\tdark = true")
else:
    delta_lines.append("\tlight = true")
(generated / "delta.gitconfig").write_text("\n".join(delta_lines) + "\n")

lazygit_src = (
    theme_dir / "families" / family / "lazygit" / f"{state['tools']['lazygit']}.yml"
)
if not lazygit_src.exists():
    sys.exit(f"theme-sync: missing lazygit theme at {lazygit_src}")

lazygit_lines = lazygit_src.read_text().splitlines()
theme_lines = []
author_lines = []
section = None

for line in lazygit_lines:
    if line.startswith("theme:"):
        section = "theme"
        continue
    if line.startswith("authorColors:"):
        section = "author"
        author_lines.append(line)
        continue
    if section == "theme":
        theme_lines.append(line)
    elif section == "author":
        author_lines.append(line)

lazygit_gui.write_text(
    "\n".join(
        [
            "# Generated by theme-sync — do not edit",
            "gui:",
            "  theme:",
            *("  " + line for line in theme_lines if line.strip()),
            *author_lines,
            "",
        ]
    )
)

sys.exit(10)
PY

if [[ $sync_exit -ne 0 && $sync_exit -ne 10 ]]; then
  exit "$sync_exit"
fi

appearance="$(python3 -c 'import json, pathlib, os; p=pathlib.Path(os.environ["STATE_DIR"])/"current.json"; print(json.loads(p.read_text())["appearance"])')"
expected_tmux_theme="$GENERATED_DIR/tmux-${appearance}.conf"
tmux_theme_link="${XDG_STATE_HOME:-$HOME/.local/state}/tmux/tmux-dark-notify-theme.conf"
needs_tmux_reload=false

if [[ $sync_exit -eq 10 ]]; then
  needs_tmux_reload=true
elif [[ -L "$tmux_theme_link" ]]; then
  link_target="$(readlink "$tmux_theme_link" 2>/dev/null || true)"
  if [[ "$link_target" != "$expected_tmux_theme" ]] || [[ ! -r "$link_target" ]]; then
    needs_tmux_reload=true
  fi
fi

if $needs_tmux_reload && command -v tmux &>/dev/null && tmux has-session 2>/dev/null; then
  tmux set -g @dark-notify-theme-path-light "$GENERATED_DIR/tmux-light.conf"
  tmux set -g @dark-notify-theme-path-dark "$GENERATED_DIR/tmux-dark.conf"
  tmux source-file "$expected_tmux_theme"
  mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/tmux"
  ln -sf "$expected_tmux_theme" "$tmux_theme_link"
fi

if ! $quiet; then
  appearance="$(python3 -c 'import json, pathlib, os; p=pathlib.Path(os.environ["STATE_DIR"])/"current.json"; print(json.loads(p.read_text())["appearance"])')"
  family="$(python3 -c 'import json, pathlib, os; p=pathlib.Path(os.environ["STATE_DIR"])/"current.json"; print(json.loads(p.read_text())["family"])')"
  variant="$(python3 -c 'import json, pathlib, os; p=pathlib.Path(os.environ["STATE_DIR"])/"current.json"; d=json.loads(p.read_text()); print(d["tools"].get("p10k", d["appearance"]))')"
  echo "theme-sync: ${family} / ${variant} (${appearance})"
fi
