#!/usr/bin/env bash
# Bootstrap a fresh clone: submodules, stow, theme-sync.
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${HOME}"
STOW_FLAGS=(-v -R -t "$TARGET")

echo "==> dotfiles: $DOTFILES"

echo "==> git submodule sync && update --init --recursive"
cd "$DOTFILES"
git submodule sync --recursive
git submodule update --init --recursive

if ! command -v stow &>/dev/null; then
  if [[ "$(uname)" == Darwin ]]; then
    echo "ERROR: stow not found. Install with: brew install stow" >&2
  else
    echo "ERROR: stow not found. Install with your package manager (e.g. apt install stow, dnf install stow)" >&2
  fi
  exit 1
fi

echo "==> stow into $TARGET"
cd "$DOTFILES"
# Adopt existing regular files so stow can replace them with symlinks.
stow "${STOW_FLAGS[@]}" --adopt .

echo "==> theme-sync"
if [[ -x "$TARGET/.config/theme/bin/theme-sync" ]]; then
  "$TARGET/.config/theme/bin/theme-sync" || true
fi

mkdir -p "$TARGET/.config/git"
if [[ ! -f "$TARGET/.config/git/local" ]]; then
  cp "$DOTFILES/.config/git/local.example" "$TARGET/.config/git/local"
  echo "Created ~/.config/git/local from example — edit name/email."
fi

if [[ ! -f "$DOTFILES/.config/zsh/custom/local-env.zsh" ]] && \
   [[ -f "$DOTFILES/.config/zsh/custom/local-env.zsh.example" ]]; then
  echo "Optional: cp $DOTFILES/.config/zsh/custom/local-env.zsh.example \\"
  echo "              $DOTFILES/.config/zsh/custom/local-env.zsh"
fi

echo ""
echo "Bootstrap complete. Manual steps if not already done:"
if [[ "$(uname)" == Darwin ]]; then
  echo "  1. brew bundle install --file=$DOTFILES/Brewfile"
else
  echo "  1. Install packages with apt/dnf (see README.md — Linux section)"
fi
echo "  2. oh-my-zsh: sh -c \"\$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)\" --keep-zshrc"
echo "  3. git config --local user.email \"ID+username@users.noreply.github.com\"  # in this repo only"
echo "  4. exec zsh"
